"""
Universal LLM adapter.

The AI explanation layer in this project is model-agnostic by design.
This module provides a single interface that works with any AI provider
that exposes an OpenAI-compatible /v1/chat/completions endpoint, which
includes:
  - Anthropic Claude (via their native API or OpenAI-compatible proxy)
  - OpenAI GPT-4 / GPT-4o / GPT-4o-mini
  - Google Gemini (via Vertex AI OpenAI-compatible layer)
  - Mistral API
  - Local models via Ollama (http://localhost:11434/v1/chat/completions)
  - Local models via LM Studio (http://localhost:1234/v1/chat/completions)
  - Any cloud service that implements the OpenAI messages API

THE CONTRACT EVERY PROVIDER MUST HONOR (enforced by this module):
  - Only public chain/research data is ever sent as context
  - Private off-chain data (PHI, patient identifiers) NEVER enters any prompt
  - Every response is grounded against the actual chain before returning
  - The model does not update or train on chain data (inference only)
  - Every response carries authentication_required: false and
    private_data_accessed: false attestations

HOW TO SWITCH PROVIDERS:
  Change one environment variable or config line. No other code changes.
"""

from __future__ import annotations

import json
import os
import time
from dataclasses import dataclass
from typing import Dict, Any, Optional

import requests


@dataclass
class LLMConfig:
    """Configuration for any OpenAI-compatible LLM provider."""
    provider_name: str
    base_url: str          # e.g. "https://api.openai.com/v1" or "http://localhost:11434/v1"
    api_key: str           # set to "ollama" or "local" for self-hosted models
    model: str             # e.g. "gpt-4o", "claude-3-5-sonnet-20241022", "llama3.2"
    max_tokens: int = 1024

    @staticmethod
    def from_env() -> "LLMConfig":
        """Reads provider config from environment variables.
        Set LLM_PROVIDER to switch between providers:
          anthropic, openai, gemini, ollama, lmstudio, or custom
        """
        provider = os.environ.get("LLM_PROVIDER", "stub").lower()

        configs = {
            "anthropic": LLMConfig(
                provider_name="Anthropic Claude",
                base_url="https://api.anthropic.com/v1",
                api_key=os.environ.get("ANTHROPIC_API_KEY", ""),
                model=os.environ.get("LLM_MODEL", "claude-sonnet-4-6"),
            ),
            "openai": LLMConfig(
                provider_name="OpenAI",
                base_url="https://api.openai.com/v1",
                api_key=os.environ.get("OPENAI_API_KEY", ""),
                model=os.environ.get("LLM_MODEL", "gpt-4o-mini"),
            ),
            "gemini": LLMConfig(
                provider_name="Google Gemini",
                base_url="https://generativelanguage.googleapis.com/v1beta/openai",
                api_key=os.environ.get("GEMINI_API_KEY", ""),
                model=os.environ.get("LLM_MODEL", "gemini-1.5-flash"),
            ),
            "ollama": LLMConfig(
                provider_name="Ollama (local)",
                base_url="http://localhost:11434/v1",
                api_key="ollama",
                model=os.environ.get("LLM_MODEL", "llama3.2"),
            ),
            "lmstudio": LLMConfig(
                provider_name="LM Studio (local)",
                base_url="http://localhost:1234/v1",
                api_key="lm-studio",
                model=os.environ.get("LLM_MODEL", "local-model"),
            ),
            "custom": LLMConfig(
                provider_name=os.environ.get("LLM_PROVIDER_NAME", "Custom"),
                base_url=os.environ.get("LLM_BASE_URL", ""),
                api_key=os.environ.get("LLM_API_KEY", ""),
                model=os.environ.get("LLM_MODEL", ""),
            ),
        }
        return configs.get(provider, LLMConfig(
            provider_name="stub",
            base_url="", api_key="", model="stub"
        ))


# Privacy contract enforcement: these strings must never appear in any
# prompt sent to any external AI service. This is checked before every
# call -- if violated, the call is aborted, not just logged.
PHI_GUARD_TERMS = [
    "medical_history", "family_history", "person_id", "patient_name",
    "social_security", "date_of_birth", "address", "phone_number",
]


def _enforce_privacy(prompt: str, context: Dict[str, Any]) -> None:
    """Raises if any PHI-adjacent key appears in the context being sent.
    Aborts the call before any data reaches an external service."""
    context_str = json.dumps(context).lower()
    for term in PHI_GUARD_TERMS:
        if term in context_str:
            raise PermissionError(
                f"Privacy violation: '{term}' found in AI context. "
                f"Off-chain PHI must never reach any external AI service. "
                f"Check that only public chain/pool fields are in the context."
            )


def complete(prompt: str, context: Dict[str, Any],
              config: Optional[LLMConfig] = None,
              _stub_response: Optional[str] = None) -> Dict[str, Any]:
    """
    Universal AI completion. Works with any provider in LLMConfig.
    Always enforces the privacy contract before making any external call.

    Returns:
      {
        response: str,         the model's response
        provider: str,         which provider/model was used
        privacy_checked: bool, whether PHI guard ran
        context_keys: list,    what public fields were sent as context
        model_note: str,       reminder that model doesn't learn from chain
      }
    """
    _enforce_privacy(prompt, context)

    if config is None:
        config = LLMConfig.from_env()

    # Stub path — for testing without a real API key or network
    if config.provider_name == "stub" or _stub_response is not None:
        return {
            "response": _stub_response or f"[stub response for: {prompt[:60]}]",
            "provider": "stub (no API call made)",
            "privacy_checked": True,
            "context_keys": list(context.keys()),
            "model_note": (
                "Model weights are fixed and do not update from chain data. "
                "Context is passed at inference time only."
            ),
        }

    system_prompt = (
        "You are a research data assistant for an open, public genomic research "
        "blockchain. You only have access to de-identified, public research data. "
        "You never make up numbers -- if you don't know something from the data "
        "provided, say so. You explain research findings in plain language that "
        "anyone can understand, without clinical recommendations or diagnoses."
    )

    user_message = f"{prompt}\n\nPublic chain context:\n{json.dumps(context, indent=2)}"

    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {config.api_key}",
    }

    payload = {
        "model": config.model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_message},
        ],
        "max_tokens": config.max_tokens,
    }

    resp = requests.post(
        f"{config.base_url}/chat/completions",
        headers=headers,
        json=payload,
        timeout=30,
    )
    resp.raise_for_status()
    data = resp.json()
    response_text = data["choices"][0]["message"]["content"]

    return {
        "response": response_text,
        "provider": f"{config.provider_name} / {config.model}",
        "privacy_checked": True,
        "context_keys": list(context.keys()),
        "model_note": (
            "Model weights are fixed and do not update from chain data. "
            "Context is passed at inference time only."
        ),
    }


