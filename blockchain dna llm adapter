# Cross-implementation record verifier

def verify_external_block(block: Dict[str, Any],
                            declared_difficulty: int = 4) -> Dict[str, Any]:
    """
    Verifies a block received from ANY external implementation -- Python,
    Go, Rust, JavaScript, anything -- against the protocol spec in
    PROTOCOL.md Section 7. If this passes, the block is protocol-compatible
    regardless of what codebase produced it.
    """
    import hashlib

    checks = {}

    # 1. Hash formula (Section 2 of protocol spec)
    body = {
        "index": block.get("index"),
        "timestamp_ms": block.get("timestamp_ms"),
        "prediction_record": block.get("prediction_record"),
        "maxwell_sig": block.get("maxwell_sig"),
        "previous_hash": block.get("previous_hash"),
        "nonce": block.get("nonce"),
    }
    canonical = json.dumps(body, sort_keys=True, default=str)
    computed = hashlib.sha256(canonical.encode()).hexdigest()
    checks["hash_formula_valid"] = computed == block.get("hash")

    # 2. Difficulty requirement
    checks["meets_difficulty"] = block.get("hash", "").startswith("0" * declared_difficulty)

    # 3. Privacy contract (Section 4)
    record_str = json.dumps(block.get("prediction_record", {})).lower()
    phi_violations = [t for t in PHI_GUARD_TERMS if t in record_str]
    checks["privacy_contract_honored"] = len(phi_violations) == 0
    if phi_violations:
        checks["privacy_violations"] = phi_violations

    checks["protocol_compatible"] = all(
        v for k, v in checks.items() if k != "privacy_violations"
    )
    return checks


if __name__ == "__main__":
    print("=== LLM Adapter: provider configuration ===\n")
    config = LLMConfig.from_env()
    print(f"Active provider: {config.provider_name}")
    print(f"Model: {config.model}")
    print(f"Base URL: {config.base_url or '(none -- stub mode)'}")

    print()
    print("=== Privacy contract enforcement test ===")
    # Safe context (public data only) -- should pass
    safe_context = {"research_records": 5, "gene_frequency": {"TP53": 3}}
    try:
        _enforce_privacy("what does the data show", safe_context)
        print("Safe context: PASS (no PHI detected)")
    except PermissionError as e:
        print(f"Safe context: FAIL -- {e}")

    # Dangerous context (PHI present) -- should be blocked
    unsafe_context = {"medical_history": "hypertension", "gene_frequency": {"TP53": 3}}
    try:
        _enforce_privacy("what does the data show", unsafe_context)
        print("Unsafe context: FAIL (PHI should have been blocked)")
    except PermissionError as e:
        print(f"Unsafe context: PASS -- correctly blocked: {str(e)[:80]}...")

    print()
    print("=== Stub completion (no API key needed) ===")
    result = complete(
        "Summarize what the research data shows",
        {"research_records": 5, "mean_risk": 0.65},
        _stub_response="The chain holds 5 records with a mean risk of 0.65."
    )
    print(f"Response: {result['response']}")
    print(f"Provider: {result['provider']}")
    print(f"Privacy checked: {result['privacy_checked']}")
    print(f"Model note: {result['model_note']}")

    print()
    print("=== Cross-implementation block verification ===")
    # Simulate a block from an external Go implementation
    import hashlib
    test_record = {"gene_frequency": {"TP53": 3}, "risk_score": 0.65}
    genesis_hash = "2dff63bb80b0760d9e8cc7f1e3c034182806a9c6af866dbfd467d1a32dcee748"
    nonce = 0
    while True:
        body = {"index": 1, "timestamp_ms": 1787000000000,
                "prediction_record": test_record,
                "maxwell_sig": "00000000",
                "previous_hash": genesis_hash, "nonce": nonce}
        h = hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest()
        if h.startswith("000"):
            body["hash"] = h
            break
        nonce += 1

    result = verify_external_block(body, declared_difficulty=3)
    print(f"External block verification: {result}")
