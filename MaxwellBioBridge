DEFAULT_BIO_MARKERS = {
    "hormone_axis_1_sim": 0.50,
    "hormone_axis_2_sim": 0.50,
    "neuro_chemical_1_sim": 0.50,
    "neuro_chemical_2_sim": 0.50,
    "stress_response_sim": 0.50,
    "sleep_pressure_sim": 0.50,
    "metabolic_signal_sim": 0.50,
}


@dataclass
class ChemicalHormoneState:
    """
    Simulated body-state model.

    Values are normalized from 0.0 to 1.0. They are symbolic and are not
    tied to real biological measurements or medical interventions.
    """

    markers: Dict[str, float] = field(
        default_factory=lambda: dict(DEFAULT_BIO_MARKERS)
    )

    setpoints: Dict[str, float] = field(
        default_factory=lambda: dict(DEFAULT_BIO_MARKERS)
    )

    history: List[Dict[str, Any]] = field(default_factory=list)
    last_update: float = field(default_factory=time.time)

    @staticmethod
    def _clamp(value: float) -> float:
        return max(0.0, min(1.0, float(value)))

    def clamp(self) -> None:
        self.markers = {
            k: self._clamp(v)
            for k, v in self.markers.items()
        }

        self.setpoints = {
            k: self._clamp(v)
            for k, v in self.setpoints.items()
        }

        self.last_update = time.time()


