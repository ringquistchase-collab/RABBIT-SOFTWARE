@dataclass
class BioSafetyPolicy:
    """
    Safety policy for the simulated Bio DNA Engineer.

    This module is not a medical system and does not administer chemicals,
    hormones, drugs, or electrical stimulation. It only simulates state
    changes inside a digital twin.
    """

    max_modulation_intensity: float = 0.35
    max_session_duration_minutes: float = 10.0
    require_consent: bool = True
    consent_granted: bool = False

    # Keep this false unless you intentionally want simulated broadcast receipts.
    allow_hardware_broadcast: bool = False

    allowed_rf_channels: List[str] = field(
        default_factory=lambda: [
            "sim-rf-0",
            "sim-ble-0",
            "sim-serial-0",
        ]
    )

    medical_disclaimer: str = (
        "Simulation only. Not medical advice, not a hormone editor, "
        "not a chemical dosing system, and not a real hardware controller."
    )

    def to_json(self) -> Dict[str, Any]:
        return sanitize_json({
            "max_modulation_intensity": self.max_modulation_intensity,
            "max_session_duration_minutes": self.max_session_duration_minutes,
            "require_consent": self.require_consent,
            "consent_granted": self.consent_granted,
            "allow_hardware_broadcast": self.allow_hardware_broadcast,
            "allowed_rf_channels": list(self.allowed_rf_channels),
            "medical_disclaimer": self.medical_disclaimer,
        })


