# ------------------------------------------------------------
# Fallback utilities in case bridge utilities are not present
# ------------------------------------------------------------

if "sanitize_json" not in globals():
    def sanitize_json(obj: Any) -> Any:
        return json.loads(json.dumps(obj, sort_keys=True, default=str))


if "deterministic_hash" not in globals():
    def deterministic_hash(obj: Any) -> str:
        return hashlib.sha256(
            json.dumps(obj, sort_keys=True, default=str).encode("utf-8")
        ).hexdigest()


if "merkle_root" not in globals():
    def merkle_root(hashes: List[str]) -> str:
        if not hashes:
            return hashlib.sha256(b"empty_merkle_root").hexdigest()

        level = [h for h in hashes if h]

        if not level:
            return hashlib.sha256(b"empty_merkle_root").hexdigest()

        while len(level) > 1:
            if len(level) % 2 == 1:
                level.append(level[-1])

            next_level = []

            for i in range(0, len(level), 2):
                combined = f"{level[i]}{level[i + 1]}".encode("utf-8")
                next_level.append(hashlib.sha256(combined).hexdigest())

            level = next_level

        return level[0]


