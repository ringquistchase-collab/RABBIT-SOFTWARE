@dataclass
class GuideRNA:
    """
    Simulated guide RNA object.

    target: sequence to match
    pam: simple PAM pattern, e.g. NGG
    """

    guide_id: str
    target: str
    pam: str = "NGG"


@dataclass
class EditPlan:
    """
    A fully resolved simulated edit plan.
    """

    guide_id: str
    target: str
    pam: str
    position: int
    target_length: int
    mode: str
    payload: str
    original_segment: str
    edited_segment: str
    edited_sequence: str
    notes: List[str] = field(default_factory=list)


class CRISPRNodeProgrammer:
    """
    Simulated CRISPR-like node programming system.

    This performs symbolic sequence edits only. It does not interact with
    real genomes, cells, or laboratory equipment.
    """

    def _match_pattern(self, sequence: str, start: int, pattern: str) -> bool:
        """
        Match a simple pattern where 'N' means any base.

        Example:
            pattern = 'NGG'
            sequence segment = 'AGG' -> True
            sequence segment = 'TTT' -> False
        """
        pattern = pattern.upper()

        if start < 0 or start + len(pattern) > len(sequence):
            return False

        segment = sequence[start:start + len(pattern)]

        for seq_base, pat_base in zip(segment, pattern):
            if pat_base == "N":
                continue
            if seq_base != pat_base:
                return False

        return True

    def find_targets(self, sequence: str, guide: GuideRNA) -> List[int]:
        """Find all target positions with a valid downstream PAM."""
        seq = sequence.upper().replace("U", "T")
        target = guide.target.upper().replace("U", "T")

        if not target:
            return []

        hits: List[int] = []

        for i in range(0, len(seq) - len(target) + 1):
            if seq[i:i + len(target)] != target:
                continue

            pam_start = i + len(target)

            if self._match_pattern(seq, pam_start, guide.pam):
                hits.append(i)

        return hits

    def plan_edit(
        self,
        sequence: str,
        guide: GuideRNA,
        payload: str = "",
        mode: str = "replace",
        occurrence: int = 0,
    ) -> Optional[EditPlan]:
        """
        Plan a symbolic edit.

        Modes:
            replace: replace target with payload
            delete: remove target
            insert: insert payload immediately after target
            knockout: replace target with a stop-like symbolic payload
        """
        seq = sequence.upper().replace("U", "T")
        target = guide.target.upper().replace("U", "T")

        hits = self.find_targets(seq, guide)

        if not target or not hits:
            return None

        occurrence = max(0, int(occurrence))
        position = hits[min(occurrence, len(hits) - 1)]
        end = position + len(target)

        payload = payload.upper().replace("U", "T")
        payload = "".join(ch for ch in payload if ch in "ACGT")

        mode = mode.lower()
        notes: List[str] = [
            f"occurrence={occurrence}",
            f"pam={guide.pam}",
        ]

        valid_modes = {"replace", "insert", "delete", "knockout"}

        if mode not in valid_modes:
            mode = "replace"
            notes.append("mode-fallback=replace")

        if mode == "replace" and not payload:
            mode = "delete"
            notes.append("empty-payload=delete")

        original_segment = seq[position:end]

        if mode == "insert":
            edited_segment = original_segment + payload
            edited_sequence = seq[:end] + payload + seq[end:]

        elif mode == "delete":
            edited_segment = ""
            edited_sequence = seq[:position] + seq[end:]

        elif mode == "knockout":
            payload = "TAA"
            edited_segment = payload
            edited_sequence = seq[:position] + payload + seq[end:]

        else:
            payload = payload or target
            edited_segment = payload
            edited_sequence = seq[:position] + payload + seq[end:]

        return EditPlan(
            guide_id=guide.guide_id,
            target=target,
            guide.pam.upper(),
            position=position,
            target_length=len(target),
            mode=mode,
            payload=payload,
            original_segment=original_segment,
            edited_segment=edited_segment,
            edited_sequence=edited_sequence,
            notes=notes,
        )

    def apply_edit(self, sequence: str, plan: EditPlan) -> str:
        """Apply an edit plan to a sequence."""
        return plan.edited_sequence


