BASE_TO_BITS: Dict[str, int] = {
    "A": 0,
    "C": 1,
    "G": 2,
    "T": 3,
}

BITS_TO_BASE: Dict[int, str] = {
    0: "A",
    1: "C",
    2: "G",
    3: "T",
}

COMPLEMENT_TABLE: Dict[str, str] = {
    "A": "T",
    "T": "A",
    "C": "G",
    "G": "C",
    "U": "A",
    "N": "N",
}


def complement(sequence: str) -> str:
    """Return the complement strand for DNA/RNA symbols."""
    return "".join(COMPLEMENT_TABLE.get(base, "N") for base in sequence.upper())


def reverse_complement(sequence: str) -> str:
    """Return the reverse complement of a DNA/RNA sequence."""
    return complement(sequence)[::-1]


def clean_sequence(sequence: str, rna: bool = False, allow_n: bool = False) -> str:
    """Normalize and filter a genetic sequence."""
    valid = "ACGTUN" if allow_n else "ACGTU"
    seq = "".join(ch for ch in sequence.upper() if ch in valid)

    if rna:
        seq = seq.replace("T", "U")
    else:
        seq = seq.replace("U", "T")

    return seq


