class GeneticCodeTranslator:
    """
    Translates DNA/RNA sequences into protein-like symbolic output.

    This uses the standard genetic code. Stop codons are represented as '*'.
    """

    CODON_TABLE: Dict[str, str] = {
        "UUU": "F", "UUC": "F", "UUA": "L", "UUG": "L",
        "UCU": "S", "UCC": "S", "UCA": "S", "UCG": "S",
        "UAU": "Y", "UAC": "Y", "UAA": "*", "UAG": "*",
        "UGU": "C", "UGC": "C", "UGA": "*", "UGG": "W",

        "CUU": "L", "CUC": "L", "CUA": "L", "CUG": "L",
        "CCU": "P", "CCC": "P", "CCA": "P", "CCG": "P",
        "CAU": "H", "CAC": "H", "CAA": "Q", "CAG": "Q",
        "CGU": "R", "CGC": "R", "CGA": "R", "CGG": "R",

        "AUU": "I", "AUC": "I", "AUA": "I", "AUG": "M",
        "ACU": "T", "ACC": "T", "ACA": "T", "ACG": "T",
        "AAU": "N", "AAC": "N", "AAA": "K", "AAG": "K",
        "AGU": "S", "AGC": "S", "AGA": "R", "AGG": "R",

        "GUU": "V", "GUC": "V", "GUA": "V", "GUG": "V",
        "GCU": "A", "GCC": "A", "GCA": "A", "GCG": "A",
        "GAU": "D", "GAC": "D", "GAA": "E", "GAG": "E",
        "GGU": "G", "GGC": "G", "GGA": "G", "GGG": "G",
    }

    def normalize_rna(self, sequence: str) -> str:
        """Normalize input to RNA alphabet."""
        seq = sequence.upper().replace(" ", "").replace("\n", "").replace("\r", "")
        seq = "".join(ch for ch in seq if ch in "ACGTU")
        return seq.replace("T", "U")

    def dna_to_mrna(self, sequence: str, template: bool = False) -> str:
        """
        Convert DNA to mRNA.

        If template=False, the input is treated as the coding strand.
        If template=True, the input is treated as the template strand.
        """
        seq = clean_sequence(sequence, rna=False, allow_n=True)

        if template:
            seq = complement(seq)

        return seq.replace("T", "U")

    def translate(
        self,
        sequence: str,
        reading_frame: int = 0,
        to_stop: bool = False,
    ) -> str:
        """Translate an RNA or DNA sequence into a protein string."""
        rna = self.normalize_rna(sequence)
        reading_frame = max(0, int(reading_frame))

        protein: List[str] = []

        for i in range(reading_frame, len(rna) - 2, 3):
            codon = rna[i:i + 3]
            amino_acid = self.CODON_TABLE.get(codon, "X")

            if amino_acid == "*" and to_stop:
                break

            protein.append(amino_acid)

        return "".join(protein)


