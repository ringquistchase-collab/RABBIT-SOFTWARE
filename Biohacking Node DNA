@dataclass
class NodeBioState:
    """
    State object for a biological/RF node.
    """

    node_id: str
    dna_address: str
    genome: str = ""
    status: str = "idle"
    expression: float = 1.0
    rf_channel: int = 0
    created_at: float = field(default_factory=time.time)
    last_command: Optional[Dict[str, Any]] = None


class BioNodeIntegrationSystem:
    """
    Top-level integration system connecting:
    - DNA payload storage
    - RF packetization
    - genetic translation
    - epigenetic modulation
    - CRISPR-like symbolic node programming
    """

    def __init__(
        self,
        center_frequency: float = 2.4e9,
        channel_spacing: float = 250e3,
    ) -> None:
        self.mapper = GeneticToRFMapper(
            center_frequency=center_frequency,
            channel_spacing=channel_spacing,
        )

        self.translator = GeneticCodeTranslator()
        self.epigenetic = EpigeneticModulator()
        self.crispr = CRISPRNodeProgrammer()

        self.nodes: Dict[str, NodeBioState] = {}
        self.epigenetic_states: Dict[str, EpigeneticState] = {}
        self.storage: Dict[str, Dict[str, Any]] = {}

    # -------------------------------------------------------------------------
    # Node management
    # -------------------------------------------------------------------------

    def _require_node(self, node_id: str) -> NodeBioState:
        if node_id not in self.nodes:
            raise KeyError(f"Unknown node: {node_id}")

        return self.nodes[node_id]

    def register_node(
        self,
        node_id: str,
        rf_channel: Optional[int] = None,
    ) -> NodeBioState:
        """Register a node and assign it a DNA address and synthetic genome."""
        if node_id in self.nodes:
            return self.nodes[node_id]

        seed = hashlib.sha256(node_id.encode("utf-8")).digest()

        # Synthetic genome: 32-byte seed repeated to produce 512 DNA bases.
        genome = self._bytes_to_dna(seed * 4)

        # DNA address: compact identifier encoded as DNA.
        dna_address = self._bytes_to_dna(seed)[:48]

        channel = len(self.nodes) if rf_channel is None else int(rf_channel)

        node = NodeBioState(
            node_id=node_id,
            dna_address=dna_address,
            genome=genome,
            rf_channel=channel,
        )

        self.nodes[node_id] = node
        self.epigenetic_states[node_id] = EpigeneticState()

        return node

    def get_epigenetic_state(self, node_id: str) -> EpigeneticState:
        self._require_node(node_id)
        return self.epigenetic_states.setdefault(node_id, EpigeneticState())

    # -------------------------------------------------------------------------
    # DNA payload encoding
    # -------------------------------------------------------------------------

    def _bytes_to_dna(self, data: bytes) -> str:
        """Encode bytes into DNA using 2 bits per base."""
        bases: List[str] = []

        for byte in data:
            bases.append(BITS_TO_BASE[(byte >> 6) & 0x03])
            bases.append(BITS_TO_BASE[(byte >> 4) & 0x03])
            bases.append(BITS_TO_BASE[(byte >> 2) & 0x03])
            bases.append(BITS_TO_BASE[byte & 0x03])

        return "".join(bases)

    def _dna_to_bytes(self, dna: str) -> bytes:
        """Decode DNA into bytes. Ignores incomplete trailing bases."""
        dna = dna.upper().replace("U", "T")

        values: List[int] = []

        for base in dna:
            if base in BASE_TO_BITS:
                values.append(BASE_TO_BITS[base])

        out = bytearray()

        full_length = len(values) - (len(values) % 4)

        for i in range(0, full_length, 4):
            byte = 0

            for value in values[i:i + 4]:
                byte = (byte << 2) | value

            out.append(byte)

        return bytes(out)

    def payload_to_dna(self, payload: Any) -> str:
        """Serialize a JSON-compatible payload into compressed DNA storage."""
        raw = json.dumps(
            payload,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")

        compressed = zlib.compress(raw, level=9)
        return self._bytes_to_dna(compressed)

    def dna_to_payload(self, dna: str) -> Any:
        """Decode DNA storage back into a JSON-compatible payload."""
        compressed = self._dna_to_bytes(dna)
        raw = zlib.decompress(compressed)
        return json.loads(raw.decode("utf-8"))

    # -------------------------------------------------------------------------
    # Command encoding / decoding
    # -------------------------------------------------------------------------

    def encode_command(
        self,
        node_id: str,
        command: Dict[str, Any],
        symbol_duration: float = 1e-3,
    ) -> RFPacket:
        """Encode a node command into DNA, then map it to an RF packet."""
        node = self._require_node(node_id)

        envelope = {
            "node_id": node_id,
            "dna_address": node.dna_address,
            "timestamp": time.time(),
            "command": command,
        }

        dna = self.payload_to_dna(envelope)
        packet = self.mapper.sequence_to_rf(dna, symbol_duration=symbol_duration)

        packet.metadata.update(
            {
                "kind": "command",
                "node_id": node_id,
                "dna_address": node.dna_address,
            }
        )

        node.status = "commanded"
        node.last_command = envelope

        return packet

    def decode_command(self, packet: RFPacket) -> Optional[Dict[str, Any]]:
        """Decode an RF packet back into a command envelope."""
        dna = self.mapper.rf_to_sequence(packet)

        try:
            return self.dna_to_payload(dna)
        except Exception:
            return None

    # -------------------------------------------------------------------------
    # Storage
    # -------------------------------------------------------------------------

    def store_payload(
        self,
        payload: Any,
        namespace: str = "default",
    ) -> Tuple[str, str]:
        """Store a payload as DNA and return record_id and dna."""
        dna = self.payload_to_dna(payload)

        record_id = hashlib.sha256(dna.encode("utf-8")).hexdigest()[:24]

        self.storage[record_id] = {
            "namespace": namespace,
            "dna": dna,
            "payload": payload,
            "stored_at": time.time(),
        }

        return record_id, dna

    def retrieve_payload(
        self,
        record_id: Optional[str] = None,
        dna: Optional[str] = None,
    ) -> Optional[Any]:
        """Retrieve a stored payload by record ID or DNA string."""
        if record_id and record_id in self.storage:
            return self.storage[record_id]["payload"]

        if dna:
            for record in self.storage.values():
                if record["dna"] == dna:
                    return record["payload"]

            try:
                return self.dna_to_payload(dna)
            except Exception:
                return None

        return None

    # -------------------------------------------------------------------------
    # Epigenetic node modulation
    # -------------------------------------------------------------------------

    def stimulate_node(
        self,
        node_id: str,
        intensity: float = 0.5,
        duration: float = 1.0,
    ) -> float:
        """Apply simulated stimulation and update node expression."""
        node = self._require_node(node_id)
        state = self.get_epigenetic_state(node_id)

        self.epigenetic.stimulate_node(state, intensity=intensity, duration=duration)

        node.expression = self.epigenetic.expression_multiplier(state)
        node.status = "expressing"

        return node.expression

    def methylate_node(
        self,
        node_id: str,
        positions: List[int],
        strength: float = 0.5,
    ) -> EpigeneticState:
        """Apply simulated methylation to selected node positions."""
        node = self._require_node(node_id)
        state = self.get_epigenetic_state(node_id)

        self.epigenetic.methylate(state, positions=positions, strength=strength)
        node.expression = self.epigenetic.expression_multiplier(state)

        return state

    def demethylate_node(
        self,
        node_id: str,
        positions: List[int],
        strength: float = 0.5,
    ) -> EpigeneticState:
        """Apply simulated demethylation to selected node positions."""
        node = self._require_node(node_id)
        state = self.get_epigenetic_state(node_id)

        self.epigenetic.demethylate(state, positions=positions, strength=strength)
        node.expression = self.epigenetic.expression_multiplier(state)

        return state

    def acetylate_node(
        self,
        node_id: str,
        delta: float = 0.1,
    ) -> EpigeneticState:
        """Apply simulated histone acetylation change."""
        node = self._require_node(node_id)
        state = self.get_epigenetic_state(node_id)

        self.epigenetic.acetylate(state, delta=delta)
        node.expression = self.epigenetic.expression_multiplier(state)

        return state

    # -------------------------------------------------------------------------
    # Genetic translation
    # -------------------------------------------------------------------------

    def transcribe_and_translate(
        self,
        sequence: str,
        template: bool = False,
        reading_frame: int = 0,
        to_stop: bool = False,
    ) -> str:
        """Transcribe DNA to mRNA and translate to protein string."""
        mrna = self.translator.dna_to_mrna(sequence, template=template)
        return self.translator.translate(
            mrna,
            reading_frame=reading_frame,
            to_stop=to_stop,
        )

    # -------------------------------------------------------------------------
    # CRISPR-like node programming
    # -------------------------------------------------------------------------

    def edit_sequence(
        self,
        sequence: str,
        guide: GuideRNA,
        payload: str = "",
        mode: str = "replace",
        occurrence: int = 0,
    ) -> Optional[EditPlan]:
        """Plan an edit on an arbitrary sequence."""
        return self.crispr.plan_edit(
            sequence=sequence,
            guide=guide,
            payload=payload,
            mode=mode,
            occurrence=occurrence,
        )

    def program_node_edit(
        self,
        node_id: str,
        guide: GuideRNA,
        payload: str = "",
        mode: str = "replace",
        occurrence: int = 0,
    ) -> Optional[EditPlan]:
        """
        Plan and apply a symbolic edit to a node's synthetic genome.
        """
        node = self._require_node(node_id)

        plan = self.crispr.plan_edit(
            sequence=node.genome,
            guide=guide,
            payload=payload,
            mode=mode,
            occurrence=occurrence,
        )

        if plan is None:
            return None

        node.genome = plan.edited_sequence
        node.status = "edited"

        return plan


