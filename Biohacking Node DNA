@dataclass
class RFPacket:
    """
    A packetized RF representation of a genetic sequence.

    Each base is mapped to a frequency offset around a center frequency.
    Phases and amplitudes are deterministic and can be used for waveform synthesis.
    """

    sequence: str
    frequencies: List[float]
    phases: List[float]
    amplitudes: List[float]
    symbol_duration: float
    checksum: str
    metadata: Dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "sequence": self.sequence,
            "frequencies": [float(x) for x in self.frequencies],
            "phases": [float(x) for x in self.phases],
            "amplitudes": [float(x) for x in self.amplitudes],
            "symbol_duration": float(self.symbol_duration),
            "checksum": self.checksum,
            "metadata": self.metadata,
        }


class GeneticToRFMapper:
    """
    Maps DNA/RNA sequences to RF frequencies for node communication.

    Each genetic base is assigned to a frequency offset around a center frequency:

        A -> -2 * channel_spacing
        C -> -1 * channel_spacing
        G -> +1 * channel_spacing
        T -> +2 * channel_spacing
        U -> same as T

    This is intentionally deterministic and reversible.
    """

    BASES: Tuple[str, ...] = ("A", "C", "G", "T", "U")

    def __init__(
        self,
        center_frequency: float = 2.4e9,
        channel_spacing: float = 250e3,
        base_power: float = 1.0,
    ) -> None:
        self.center_frequency = float(center_frequency)
        self.channel_spacing = float(channel_spacing)
        self.base_power = float(base_power)

        self.base_offsets: Dict[str, float] = {
            "A": -2.0,
            "C": -1.0,
            "G": +1.0,
            "T": +2.0,
            "U": +2.0,
        }

    def normalize(self, sequence: str) -> str:
        """Normalize sequence to canonical RF-DNA form."""
        seq = sequence.upper().replace(" ", "").replace("\n", "").replace("\r", "")
        seq = "".join(ch for ch in seq if ch in self.BASES)
        return seq.replace("U", "T")

    def base_frequency(self, base: str) -> float:
        """Return the RF frequency assigned to a base."""
        base = base.upper().replace("U", "T")
        offset = self.base_offsets.get(base, 0.0)
        return self.center_frequency + offset * self.channel_spacing

    def sequence_to_rf(
        self,
        sequence: str,
        symbol_duration: float = 1e-3,
    ) -> RFPacket:
        """Convert a genetic sequence into an RF packet."""
        normalized = self.normalize(sequence)

        frequencies: List[float] = []
        phases: List[float] = []
        amplitudes: List[float] = []

        prev_phase = 0.0
        two_pi = 2.0 * np.pi

        for i, base in enumerate(normalized):
            freq = self.base_frequency(base)

            # Use offset frequency for phase accumulation to avoid huge carrier phase values.
            phase_freq = freq - self.center_frequency
            phase = float((prev_phase + two_pi * phase_freq * symbol_duration) % two_pi)

            # Deterministic amplitude shaping.
            amp = float(self.base_power * (1.0 + 0.1 * np.sin(i * 0.35)))

            frequencies.append(float(freq))
            phases.append(phase)
            amplitudes.append(amp)

            prev_phase = phase

        checksum = hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:16]

        metadata = {
            "center_frequency": self.center_frequency,
            "channel_spacing": self.channel_spacing,
            "symbol_duration": float(symbol_duration),
            "base_count": len(normalized),
            "created_at": time.time(),
        }

        return RFPacket(
            sequence=normalized,
            frequencies=frequencies,
            phases=phases,
            amplitudes=amplitudes,
            symbol_duration=float(symbol_duration),
            checksum=checksum,
            metadata=metadata,
        )

    def rf_to_sequence(self, packet: RFPacket) -> str:
        """Decode an RF packet back into a DNA sequence by nearest-frequency mapping."""
        canonical_bases = ("A", "C", "G", "T")
        decoded: List[str] = []

        for freq in packet.frequencies:
            best_base = min(
                canonical_bases,
                key=lambda b: abs(self.base_frequency(b) - float(freq)),
            )
            decoded.append(best_base)

        return "".join(decoded)

    def verify_packet(self, packet: RFPacket) -> bool:
        """Verify packet integrity by comparing stored checksum."""
        normalized = self.normalize(packet.sequence)
        expected = hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:16]
        return expected == packet.checksum

    def generate_waveform(
        self,
        packet: RFPacket,
        sample_rate: float = 1.0e6,
        max_symbols: Optional[int] = None,
        use_baseband: bool = True,
    ) -> np.ndarray:
        """
        Generate a synthetic waveform from an RFPacket.

        If use_baseband=True, the center carrier is removed and only frequency
        offsets are synthesized. This avoids impossible sample-rate requirements
        for GHz carriers in simulation.
        """
        if not packet.frequencies:
            return np.array([], dtype=float)

        symbol_count = len(packet.frequencies)
        if max_symbols is not None:
            symbol_count = min(symbol_count, int(max_symbols))

        samples_per_symbol = max(1, int(packet.symbol_duration * sample_rate))
        t = np.arange(samples_per_symbol) / float(sample_rate)

        chunks: List[np.ndarray] = []

        for i in range(symbol_count):
            freq = float(packet.frequencies[i])

            if use_baseband:
                freq -= self.center_frequency

            phase = float(packet.phases[i]) if i < len(packet.phases) else 0.0
            amp = float(packet.amplitudes[i]) if i < len(packet.amplitudes) else self.base_power

            chunks.append(amp * np.sin(2.0 * np.pi * freq * t + phase))

        return np.concatenate(chunks)


