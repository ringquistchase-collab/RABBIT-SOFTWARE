@dataclass
class EpigeneticState:
    """
    Simulated epigenetic state for a node.

    Methylation is modeled as a map from sequence position to methylation level [0, 1].
    Histone acetylation and node gain are global scalar modulators.
    """

    methylation: Dict[int, float] = field(default_factory=dict)
    histone_acetylation: float = 0.5
    node_gain: float = 1.0
    last_updated: float = field(default_factory=time.time)

    def clamp(self) -> None:
        self.histone_acetylation = float(np.clip(self.histone_acetylation, 0.0, 1.0))
        self.node_gain = float(np.clip(self.node_gain, 0.0, 10.0))

        self.methylation = {
            int(pos): float(np.clip(level, 0.0, 1.0))
            for pos, level in self.methylation.items()
        }

        self.last_updated = time.time()


class EpigeneticModulator:
    """
    Simulates epigenetic modulation of node expression.

    This is not a biological assay; it is a control-system abstraction using
    biological metaphors.
    """

    def methylate(
        self,
        state: EpigeneticState,
        positions: List[int],
        strength: float = 0.5,
    ) -> None:
        strength = float(np.clip(strength, 0.0, 1.0))

        for pos in positions:
            pos = int(pos)
            current = state.methylation.get(pos, 0.0)
            state.methylation[pos] = current + strength

        state.clamp()

    def demethylate(
        self,
        state: EpigeneticState,
        positions: List[int],
        strength: float = 0.5,
    ) -> None:
        strength = float(np.clip(strength, 0.0, 1.0))

        for pos in positions:
            pos = int(pos)
            current = state.methylation.get(pos, 0.0)
            state.methylation[pos] = current - strength

        state.clamp()

    def acetylate(self, state: EpigeneticState, delta: float = 0.1) -> None:
        state.histone_acetylation += float(delta)
        state.clamp()

    def stimulate_node(
        self,
        state: EpigeneticState,
        intensity: float = 0.5,
        duration: float = 1.0,
    ) -> None:
        """
        Apply simulated node stimulation.

        Low-to-moderate stimulation increases acetylation and node gain.
        Stimulation also slightly reduces methylation globally.
        """
        intensity = float(np.clip(intensity, 0.0, 1.0))
        duration = max(0.0, float(duration))

        state.histone_acetylation += 0.08 * intensity * duration
        state.node_gain += 0.05 * intensity * duration

        for pos in list(state.methylation.keys()):
            state.methylation[pos] -= 0.02 * intensity * duration

        state.clamp()

    def average_methylation(self, state: EpigeneticState) -> float:
        if not state.methylation:
            return 0.0

        return float(np.mean(list(state.methylation.values())))

    def expression_multiplier(self, state: EpigeneticState) -> float:
        """
        Compute a simulated expression multiplier.

        Higher acetylation increases expression.
        Higher methylation decreases expression.
        Node gain provides an additional scalar amplifier.
        """
        avg_methylation = self.average_methylation(state)

        expression = (
            (1.0 - avg_methylation)
            * (0.25 + state.histone_acetylation)
            * state.node_gain
        )

        return max(0.0, float(expression))


