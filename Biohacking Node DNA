def main() -> None:
    system = BioNodeIntegrationSystem(
        center_frequency=2.4e9,
        channel_spacing=250e3,
    )

    # Register a node.
    node = system.register_node("node-alpha")

    print("=== NODE REGISTRATION ===")
    print(f"Node ID:      {node.node_id}")
    print(f"DNA address:  {node.dna_address[:24]}...")
    print(f"Genome size:  {len(node.genome)} bases")
    print(f"RF channel:   {node.rf_channel}")
    print()

    # Encode and decode a command.
    command = {
        "op": "set_rf",
        "channel": node.rf_channel,
        "gain": 0.8,
        "mode": "adaptive",
    }

    packet = system.encode_command(node.node_id, command)
    decoded = system.decode_command(packet)

    print("=== RF COMMAND ENCODING ===")
    print(f"DNA bases:          {len(packet.sequence)}")
    print(f"RF symbols:         {len(packet.frequencies)}")
    print(f"Checksum:           {packet.checksum}")
    print(f"Packet valid:       {system.mapper.verify_packet(packet)}")
    print(f"Decoded OK:         {decoded is not None}")
    print(f"Command matches:    {bool(decoded) and decoded.get('command') == command}")
    print()

    # Generate a small baseband waveform.
    waveform = system.mapper.generate_waveform(
        packet,
        sample_rate=1_000_000,
        max_symbols=16,
        use_baseband=True,
    )

    print("=== WAVEFORM SYNTHESIS ===")
    print(f"Waveform samples:   {waveform.size}")
    print(f"Waveform RMS:       {float(np.sqrt(np.mean(waveform ** 2))):.6f}")
    print()

    # Translation demo.
    sample_dna = "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG"
    protein = system.transcribe_and_translate(sample_dna, to_stop=True)

    print("=== TRANSLATION ===")
    print(f"DNA:      {sample_dna}")
    print(f"Protein:  {protein}")
    print()

    # CRISPR-like node editing demo.
    # Insert a known target site into the node genome so the demo always has a hit.
    node.genome = "AAAGGCCGGG" + node.genome

    guide = GuideRNA(
        guide_id="guide-1",
        target="GGCC",
        pam="NGG",
    )

    plan = system.program_node_edit(
        node_id=node.node_id,
        guide=guide,
        payload="TTAA",
        mode="replace",
        occurrence=0,
    )

    print("=== CRISPR-LIKE NODE EDIT ===")

    if plan is None:
        print("No target found.")
    else:
        print(f"Guide ID:     {plan.guide_id}")
        print(f"Target:       {plan.target}")
        print(f"PAM:          {plan.pam}")
        print(f"Position:     {plan.position}")
        print(f"Mode:         {plan.mode}")
        print(f"Original:     {plan.original_segment}")
        print(f"Edited:       {plan.edited_segment}")
        print(f"Notes:        {', '.join(plan.notes)}")
        print(f"Node status:  {node.status}")

    print()

    # Epigenetic stimulation demo.
    expression = system.stimulate_node(
        node_id=node.node_id,
        intensity=0.7,
        duration=2.0,
    )

    print("=== EPIGENETIC STIMULATION ===")
    print(f"Node expression multiplier: {expression:.4f}")
    print(f"Node status:                {node.status}")
    print()

    # DNA storage demo.
    payload = {
        "telemetry": "ok",
        "battery": 0.97,
        "temperature_c": 36.5,
        "timestamp": time.time(),
    }

    record_id, dna = system.store_payload(payload, namespace="telemetry")
    recovered = system.retrieve_payload(record_id=record_id)

    print("=== DNA DATA STORAGE ===")
    print(f"Record ID:        {record_id}")
    print(f"DNA length:       {len(dna)} bases")
    print(f"Payload recovery: {recovered == payload}")
    print()

    print("Done.")


if __name__ == "__main__":
    main()
