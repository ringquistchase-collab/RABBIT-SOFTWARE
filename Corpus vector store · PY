"""
corpus_vector_store.py
================
Real vector embeddings (TF-IDF) + cosine-similarity semantic search
over everything GrowingResearchAgent has found — the missing piece
identified earlier: this system used hashes for integrity, nothing
for MEANING. This adds that, tied to a specific DigitalDNA identity
(one corpus per seed_label, matching how the rest of this system
scopes identity).

HONEST NOTE ON THE EMBEDDING METHOD
----------------------------------------
This uses TF-IDF (term-frequency/inverse-document-frequency) vectors,
not a neural embedding model like BioBERT or sentence-transformers.
That's a real tradeoff, not a corner cut silently: TF-IDF is a
genuine, real vector-search technique (still used in production
search systems), but it matches on shared vocabulary/word statistics,
not deep semantic meaning the way a transformer-based embedding
model would — it won't realize "cardiac tumor" and "heart neoplasm"
are the same concept the way BioBERT would.

Why TF-IDF here specifically: sentence-transformers requires PyTorch,
which needs more disk space than was available in the environment
this was built in (a sandboxed container with ~3GB free — your own
machine likely has more room). If you have the space, upgrading to
real neural embeddings is a contained change — swap _vectorize() to
call a sentence-transformers model instead of TfidfVectorizer, same
interface, same persistence format for the rest of this file.

WHAT'S REAL HERE
--------------------
- Actual TF-IDF vectors computed from actual titles found by the
  research agent (trials, papers, variants, St. Jude records)
- Actual cosine similarity ranking, not string matching
- Persisted to disk per DigitalDNA identity (one corpus file per
  seed_label), survives restarts like everything else in this system

Usage
-----
    from corpus_vector_store import CorpusVectorStore

    store = CorpusVectorStore(identity="chase-allen-ringquist-dna-chain",
                               store_path="corpus_breast_cancer.json")
    store.add_documents([
        {"id": "trial:NCT123", "text": "Phase 2 trial of X in metastatic disease", "source": "trial"},
    ])
    results = store.semantic_search("advanced stage cancer treatment", top_k=5)
"""

from __future__ import annotations
import json
import os

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity


class CorpusVectorStore:
    def __init__(self, identity: str, store_path: str | None = None):
        self.identity = identity
        self.store_path = store_path
        self.documents: list[dict] = []   # [{"id", "text", "source", "url", ...}]
        self._vectorizer: TfidfVectorizer | None = None
        self._matrix = None

        if store_path and os.path.exists(store_path):
            self._load()

    def _load(self):
        with open(self.store_path) as f:
            state = json.load(f)
        if state.get("identity") != self.identity:
            raise ValueError(
                f"Store at {self.store_path} belongs to identity '{state.get('identity')}', "
                f"not '{self.identity}' — each identity should use its own store_path."
            )
        self.documents = state["documents"]
        self._refit()

    def _save(self):
        if not self.store_path:
            return
        state = {"identity": self.identity, "documents": self.documents}
        tmp_path = self.store_path + ".tmp"
        with open(tmp_path, "w") as f:
            json.dump(state, f, indent=2)
        os.replace(tmp_path, self.store_path)

    def _refit(self):
        """TF-IDF needs the full vocabulary, so it refits on every add.
        Fine up to a few thousand documents; if this corpus grows much
        larger than that, this is the first thing worth optimizing."""
        if not self.documents:
            self._vectorizer = None
            self._matrix = None
            return
        texts = [d["text"] for d in self.documents]
        self._vectorizer = TfidfVectorizer(stop_words="english", max_features=5000)
        self._matrix = self._vectorizer.fit_transform(texts)

    def add_documents(self, new_docs: list[dict]) -> int:
        """Dedupes by id — adding the same real record twice is a no-op,
        same deduplication principle as growing_research_agent.py's known_ids."""
        existing_ids = {d["id"] for d in self.documents}
        added = 0
        for doc in new_docs:
            if doc["id"] not in existing_ids and doc.get("text"):
                self.documents.append(doc)
                existing_ids.add(doc["id"])
                added += 1
        if added:
            self._refit()
            self._save()
        return added

    def semantic_search(self, query: str, top_k: int = 5) -> list[dict]:
        if not self.documents or self._vectorizer is None:
            return []
        query_vec = self._vectorizer.transform([query])
        similarities = cosine_similarity(query_vec, self._matrix)[0]
        ranked = sorted(zip(self.documents, similarities), key=lambda x: -x[1])
        return [{**doc, "similarity": round(float(sim), 4)} for doc, sim in ranked[:top_k] if sim > 0]

    def find_similar(self, doc_id: str, top_k: int = 5) -> list[dict]:
        idx = next((i for i, d in enumerate(self.documents) if d["id"] == doc_id), None)
        if idx is None or self._matrix is None:
            return []
        similarities = cosine_similarity(self._matrix[idx], self._matrix)[0]
        ranked = sorted(
            [(d, s) for i, (d, s) in enumerate(zip(self.documents, similarities)) if i != idx],
            key=lambda x: -x[1],
        )
        return [{**doc, "similarity": round(float(sim), 4)} for doc, sim in ranked[:top_k] if sim > 0]

    def __len__(self):
        return len(self.documents)


def documents_from_research_results(results: dict) -> list[dict]:
    """Converts GrowingResearchAgent's found['trials'/'articles'/'variants'/...]
    into this store's document format. Real titles only — no fabricated text."""
    docs = []
    for t in results.get("trials", []):
        if t.get("title"):
            docs.append({"id": f"trial:{t.get('nct_id')}", "text": t["title"], "source": "trial", "url": t.get("url")})
    for a in results.get("articles", []):
        if a.get("title"):
            docs.append({"id": f"article:{a.get('pmid')}", "text": a["title"], "source": "pubmed", "url": a.get("url")})
    for p in results.get("stjude_papers", []):
        if p.get("title"):
            docs.append({"id": f"stjude_paper:{p.get('pmid')}", "text": p["title"], "source": "stjude", "url": p.get("url")})
    return docs


